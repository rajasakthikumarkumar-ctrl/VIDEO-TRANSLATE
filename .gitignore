# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
client/node_modules/
server/node_modules/

# ── React build output ────────────────────────────────────────────────────────
client/build/

# ── Secrets — NEVER commit these ─────────────────────────────────────────────
.env
.env.local
.env.*.local
server/.env

# NOTE: client/.env.production is NOT in this list because it contains only
# public URLs (API endpoints visible in the browser), not secrets.
# It must be committed so Render can build with the correct backend URL.

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS / Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
