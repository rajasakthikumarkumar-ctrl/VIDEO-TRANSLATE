# ─────────────────────────────────────────────────────────────────────────────
# .env.development  —  used by Create React App when NODE_ENV=development
#
# This file makes the localhost defaults explicit and self-documenting.
# `npm start` automatically uses this file.
#
# These are the same values that config.js already falls back to,
# but being explicit here avoids confusion when debugging.
# ─────────────────────────────────────────────────────────────────────────────

REACT_APP_API_BASE=http://localhost:5001/api
REACT_APP_SOCKET_URL=http://localhost:5001
