# ─────────────────────────────────────────────────────────────────────────────
# .env.production  —  used by Create React App when NODE_ENV=production
#
# Render reads this file automatically during `npm run build`.
# These values are baked into the static JS bundle at build time.
# They are NOT runtime secrets — they are public URLs visible in the browser.
#
# For Render deployment:
#   - Client service: https://video-meet-client.onrender.com
#   - Server service: https://video-meet-aj54.onrender.com
#
# These values point the compiled React bundle at the Render backend.
# ─────────────────────────────────────────────────────────────────────────────

REACT_APP_API_BASE=https://video-meet-aj54.onrender.com/api
REACT_APP_SOCKET_URL=https://video-meet-aj54.onrender.com
